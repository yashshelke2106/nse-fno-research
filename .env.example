# Copy to .env and fill in your own values. .env is git-ignored.
# Only the live data feed needs these; the tests and the backtester do not.

# Dhan broker API (https://dhanhq.co/docs/v2/)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=          # trading-API JWT; expires daily
DHAN_DATA_TOKEN=            # data-API token, if your plan issues one
DHAN_DATA_API_KEY=
DHAN_DATA_API_SECRET=

# Optional
NSE_API_KEY=
NSE_API_SECRET=
USE_MOCK_DATA=0             # 1 = no broker connection at all
INSTRUMENT_MODE=futures
